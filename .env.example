# TOTO Development Operations & Management System
# Server Port
PORT=5000

# PostgreSQL Database Configuration (Source of Truth for Auth, Users, Roles & Security)
DATABASE_URL=postgresql://postgres:password@localhost:5432/toto_crm
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=password
PGDATABASE=toto_crm

# JWT Secret & Session Security
JWT_SECRET=toto-crm-super-secure-jwt-secret-key-2026

# Google Sheets API Configuration (Operational Business Data Only: Orders, Expenses, Payouts)
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Telegram Bot Integrations
TELEGRAM_SALES_BOT_TOKEN=
TELEGRAM_SALES_CHAT_ID=
TELEGRAM_EXPENSE_BOT_TOKEN=
TELEGRAM_EXPENSE_CHAT_ID=
TELEGRAM_PAYOUT_BOT_TOKEN=
TELEGRAM_PAYOUT_CHAT_ID=
