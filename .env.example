# TOTO Development Operations & Management System
# Server Port
PORT=5000

# Google Sheets API Configuration
# 1. Provide your Google Sheet ID (from the sheet URL: https://docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SPREADSHEET_ID=

# 2. Provide your Google Service Account Email
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# 3. Provide your Google Service Account Private Key (include -----BEGIN PRIVATE KEY----- ... -----END PRIVATE KEY-----)
GOOGLE_PRIVATE_KEY=

# Telegram Bot 1: Sales & Orders Bot
TELEGRAM_SALES_BOT_TOKEN=
TELEGRAM_SALES_CHAT_ID=

# Telegram Bot 2: Expense & Cost Management Bot
TELEGRAM_EXPENSE_BOT_TOKEN=
TELEGRAM_EXPENSE_CHAT_ID=

# Telegram Bot 3: Employee / Resource / Project Payout Bot
TELEGRAM_PAYOUT_BOT_TOKEN=
TELEGRAM_PAYOUT_CHAT_ID=
